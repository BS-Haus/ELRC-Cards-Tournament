# Local dev: copy to .env.local. Never put real production values in this file.
DATABASE_URL="postgres://cards:cards@localhost:5432/cards"

# Signs the session cookie. Production refuses anything under 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="dev-only-change-me-please-0000000000000000000000"

# Organiser code: unlocks creating events, drawing groups, finals and fixes for 12 hours.
# 8+ characters. Unset = nobody can organise.
ORGANISER_CODE="dev-organiser"
